PORT=3000
# Mono test secret from the Mono dashboard. Sandbox and production use the same API host;
# use a test key for sandbox activity.
MONO_SECRET_KEY=

# Optional organization's AI document extraction adapter implementing src/extraction.ts contract.
DOCUMENT_EXTRACTION_URL=
DOCUMENT_EXTRACTION_API_KEY=
HOST=127.0.0.1
AUDITTRAK_DATABASE=data/audittrak.sqlite
# Set true only when served over HTTPS.
COOKIE_SECURE=false
# Operator-only mapping: {"business UUID":"consented Mono sandbox account ID"}
MONO_ACCOUNT_BINDINGS={}
# Optional secret for legacy provider endpoints; use authenticated v1 endpoints instead.
PROVIDER_ACCESS_TOKEN=
# Override local sample credentials before running npm run seed on a shared installation.
DEMO_PASSWORD=
REVIEWER_PASSWORD=

# Hosted persistence: use the Neon pooled PostgreSQL connection string.
DATABASE_URL=
# Set automatically by the Vercel Function entrypoint.
AUDITTRAK_SERVERLESS=false
