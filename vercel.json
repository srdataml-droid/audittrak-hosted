{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public/app",
  "regions": ["lhr1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{data/**,public/**}",
      "excludeFiles": "{docs/**,test/**}"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
